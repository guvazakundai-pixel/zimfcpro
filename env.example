# ── Required ───────────────────────────────────────────────
# Database (Turso / libsql)
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
USE_TURSO="true"

# Fallback for local development (used when USE_TURSO is not "true")
DATABASE_URL="file:./prisma/dev.db"

# JWT signing secret (min 32 random chars for production)
JWT_SECRET="replace-with-32-plus-random-bytes"

# CSRF secret (defaults to JWT_SECRET if not set)
# CSRF_SECRET="another-random-secret"

# Application URL (no trailing slash)
NEXT_PUBLIC_URL="https://zimfcpro.co.zw"

# ── Optional — Email (Resend recommended) ──────────────────
# RESEND_API_KEY="re_..."
# FROM_EMAIL="ZIM FCPRO <noreply@zimfcpro.co.zw>"
# EMAIL_FROM="ZIM FCPRO <noreply@zimfcpro.co.zw>"

# ── SMTP fallback (if Resend not configured) ───────────────
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_USER="resend"
# SMTP_PASS="re_xxxxx"

# ── Optional — WebSocket server (if running separately) ───
# NEXT_PUBLIC_SOCKET_URL="wss://socket.zimfcpro.co.zw"

# ── Optional — Cloudinary (screenshot uploads) ────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."

# ── Optional — WhatsApp Business API ──────────────────────
# WHATSAPP_PHONE_ID="..."
# WHATSAPP_TOKEN="..."